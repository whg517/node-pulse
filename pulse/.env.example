# ==================================
# Node-Pulse API Configuration
# ==================================
# This file contains all environment variables for the pulse-api application.
# Copy this file to .env and update with your values.
# DO NOT commit .env to version control.

# ==================================
# Server Configuration
# ==================================
# Server port (default: 6532)
PULSE_SERVER_PORT=6532

# Server read timeout in seconds (default: 15)
PULSE_SERVER_READ_TIMEOUT=15

# Server write timeout in seconds (default: 15)
PULSE_SERVER_WRITE_TIMEOUT=15

# Server idle timeout in seconds (default: 60)
PULSE_SERVER_IDLE_TIMEOUT=60

# Server mode: debug, release, test (default: debug)
# - debug: Development mode with detailed logging
# - release: Production mode
# - test: Testing mode
PULSE_SERVER_MODE=debug

# ==================================
# Database Configuration
# ==================================
# PostgreSQL connection URL (required)
# Format: postgres://user:password@host:port/database?sslmode=mode
PULSE_DATABASE_URL=postgres://user:password@localhost:5432/nodepulse?sslmode=disable

# Maximum database connections (default: 10)
PULSE_DATABASE_MAX_CONNECTIONS=10

# Minimum database connections (default: 1)
PULSE_DATABASE_MIN_CONNECTIONS=1

# Connection max lifetime in seconds (default: 3600)
PULSE_DATABASE_CONN_MAX_LIFETIME=3600

# Connection max idle time in seconds (default: 300)
PULSE_DATABASE_CONN_MAX_IDLE_TIME=300

# ==================================
# Cleanup Configuration
# ==================================
# Enable automatic cleanup tasks (default: true)
PULSE_CLEANUP_ENABLED=true

# Cleanup interval in seconds (default: 3600 = 1 hour)
PULSE_CLEANUP_INTERVAL=3600

# Data retention days (default: 7)
PULSE_CLEANUP_RETENTION_DAYS=7

# Slow query threshold in milliseconds (default: 30000)
PULSE_CLEANUP_SLOW_THRESHOLD=30000

# ==================================
# Logging Configuration
# ==================================
# Log level: debug, info, warn, error (default: info)
PULSE_LOG_LEVEL=info

# Log format: text, json (default: text)
PULSE_LOG_FORMAT=text

# Log output: stdout, stderr, or file path (default: stdout)
PULSE_LOG_OUTPUT=stdout

# ==================================
# CORS Configuration
# ==================================
# Allowed origins for CORS (comma-separated, default: http://localhost:4173)
# Use * to allow all origins (not recommended for production)
PULSE_CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# Allowed methods for CORS (comma-separated, default: GET,POST,PUT,DELETE,OPTIONS)
PULSE_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers for CORS (comma-separated)
PULSE_CORS_ALLOWED_HEADERS=Content-Type,Authorization

# CORS max age in seconds (default: 86400 = 24 hours)
PULSE_CORS_MAX_AGE=86400

# ==================================
# Admin User Configuration
# ==================================
# Default admin username (default: admin)
# WARNING: Change this in production!
PULSE_ADMIN_USERNAME=admin

# Default admin password (default: Admin123)
# WARNING: Change this in production! Use a strong password.
# Note: Password must be 8-32 chars with uppercase, lowercase, and digit
PULSE_ADMIN_PASSWORD=Admin123

# ==================================
# Session Configuration
# ==================================
# Session secret for cookie encryption (auto-generated if not set)
# WARNING: Set a strong random string in production!
# Example: PULSE_SESSION_SECRET=$(openssl rand -hex 32)
PULSE_SESSION_SECRET=

# Session expiration time in hours (default: 24)
PULSE_SESSION_EXPIRATION_HOURS=24

# Session cookie secure flag (true in production, false in development)
# This is automatically derived from PULSE_SERVER_MODE if not set
# PULSE_SESSION_COOKIE_SECURE=false

# Session cookie SameSite policy: Strict, Lax, None (default: Lax)
PULSE_SESSION_COOKIE_SAMESITE=Lax

# ==================================
# JWT Configuration
# ==================================
# JWT secret for token signing (auto-generated if not set)
# WARNING: Set a strong random string in production!
# Example: PULSE_JWT_SECRET=$(openssl rand -hex 32)
PULSE_JWT_SECRET=

# JWT expiration time in hours (default: 24)
PULSE_JWT_EXPIRATION_HOURS=24

# ==================================
# Legacy Environment Variables (Deprecated)
# ==================================
# The following variables are still supported for backward compatibility
# but will be removed in future versions. Please use PULSE_* prefixed variables.
# - PULSE_PORT → PULSE_SERVER_PORT
# - PULSE_MODE → PULSE_SERVER_MODE
# - DATABASE_URL → PULSE_DATABASE_URL
# - LOG_LEVEL → PULSE_LOG_LEVEL
# - CORS_ALLOWED_ORIGINS → PULSE_CORS_ALLOWED_ORIGINS
# - ADMIN_USERNAME → PULSE_ADMIN_USERNAME
# - ADMIN_PASSWORD → PULSE_ADMIN_PASSWORD
# - SESSION_SECRET → PULSE_SESSION_SECRET
# - JWT_SECRET → PULSE_JWT_SECRET
