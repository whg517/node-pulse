# Example environment for the production compose stack
# (deploy/docker/docker-compose.prod.yml).
# Copy to .env and fill in real values before `docker compose up -d --build`.
#
#   cp .env.example .env
#
# Generate strong secrets with: openssl rand -hex 32

# ---- PostgreSQL ----
POSTGRES_DB=nodepulse
POSTGRES_USER=nodepulse
# Required: a strong password for the database user.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---- Pulse API ----
PULSE_PORT=6532
PULSE_SERVER_MODE=release
# Externally reachable URL (used in webhook payloads / exported links).
PULSE_SERVER_BASE_URL=http://localhost:6532

# Initial admin account (created on first run).
PULSE_ADMIN_USERNAME=admin
# Required: 8-32 chars with upper/lower case and a digit.
PULSE_ADMIN_PASSWORD=change-me-Admin123

# Required secrets (use `openssl rand -hex 32`).
PULSE_SESSION_SECRET=
PULSE_JWT_SECRET=

# Comma-separated list of allowed CORS origins.
PULSE_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Optional distributed tracing (OTLP gRPC collector).
PULSE_TELEMETRY_ENABLED=false
# PULSE_TELEMETRY_OTLP_ENDPOINT=otel-collector:4317

# ---- Frontend (nginx) ----
FRONTEND_PORT=80
