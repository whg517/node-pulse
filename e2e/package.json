{
  "name": "node-pulse-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke/",
    "test:smoke:fast": "playwright test tests/smoke/ --project=chromium --workers=4",
    "test:auth": "playwright test tests/auth/",
    "test:nodes": "playwright test tests/nodes/",
    "test:alerts": "playwright test tests/alerts/",
    "test:webhooks": "playwright test tests/webhooks/",
    "test:export": "playwright test tests/export/",
    "test:rbac": "playwright test tests/rbac/",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "docker:up": "docker compose -f docker-compose.e2e.yml up -d",
    "docker:down": "docker compose -f docker-compose.e2e.yml down",
    "docker:logs": "docker compose -f docker-compose.e2e.yml logs -f",
    "docker:reset": "docker compose -f docker-compose.e2e.yml down -v && docker compose -f docker-compose.e2e.yml up -d"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
