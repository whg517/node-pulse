# NodePulse Beacon Configuration
# Copy this file to /etc/beacon/beacon.yaml or ./beacon.yaml

# Required: Pulse server URL (HTTP/HTTPS)
pulse_server: https://pulse.example.com

# Required: Unique node identifier (alphanumeric, hyphens, underscores)
node_id: us-east-01

# Required: Human-readable node name
node_name: "美国东部-节点01"

# Optional: Region label
region: us-east

# Optional: Custom tags
tags:
  - production
  - east-coast

# Required: API Key for JWT authentication
# Generate this on the Pulse server and associate it with your node
api_key: your-beacon-api-key-here

# Optional: Probe configurations (for Story 3.3)
# If not specified, default probes will be used
probes:
  - type: tcp_ping
    target: 8.8.8.8
    port: 80
    interval: 300      # seconds (60-300)
    count: 10          # probe attempts (1-100)
    timeout_seconds: 5 # seconds (1-30)

  - type: udp_ping
    target: 8.8.8.8
    port: 53
    interval: 300
    count: 10
    timeout_seconds: 5

  - type: mtr
    target: example.com
    interval: 300
    count: 3
    timeout_seconds: 5
    max_hops: 30
    packet_size: 128

# Optional: Reconnect configuration (for Story 2.6)
reconnect:
  max_retries: 10          # Maximum retry attempts (1-100)
  retry_interval: 60       # Seconds between retries (1-600)
  backoff: exponential      # Strategy: exponential, linear, constant

# Optional: Prometheus metrics configuration (for Story 3.8)
# Exposes /metrics endpoint for Prometheus scraping
metrics_enabled: true      # Enable/disable metrics server (default: true)
metrics_port: 2112         # Metrics server port (default: 2112, range: 1024-65535)
metrics_update_seconds: 10 # Metrics update interval (default: 10, range: 10-60 seconds)

# Optional: Debug mode (for Story 3.10)
# When true, log level is forced to DEBUG regardless of log.level below.
debug_mode: false         # default: false

# Optional: Logging configuration (for Story 3.9)
# Logs are rotated via lumberjack into log_file.
log_level: INFO           # DEBUG, INFO, WARN, ERROR (default: INFO)
log_file: /var/log/beacon/beacon.log  # default path
log_max_size: 10          # max MB per log file before rotation (default: 10)
log_max_age: 7            # days to retain rotated logs (default: 7)
log_max_backups: 10       # number of rotated logs to keep (default: 10)
log_compress: false       # gzip rotated logs (default: false)
log_to_console: false     # also write to stdout (default: false)

# Optional: Resource monitor configuration (for Story 3.11)
# Monitors the beacon's own CPU/memory and degrades probe cadence under pressure.
resource_monitor:
  enabled: false                       # default: false
  check_interval_seconds: 60           # default: 60
  thresholds:                          # "normal" ceilings; exceed to trigger degradation
    cpu_microcores: 100                # default: 100
    memory_mb: 100                     # default: 100
  degradation:
    degraded_level:                    # first-stage backoff
      cpu_microcores: 200              # default: 200
      memory_mb: 150                   # default: 150
      interval_multiplier: 2           # multiply probe interval by this (default: 2)
    critical_level:                    # second-stage backoff
      cpu_microcores: 300              # default: 300
      memory_mb: 200                   # default: 200
      interval_multiplier: 3           # default: 3
    recovery:
      consecutive_normal_checks: 3     # checks below threshold before resuming (default: 3)
    alerting:
      suppression_window_seconds: 300  # min seconds between resource alerts (default: 300)

# Optional: Dual-mode support (FR-4.1.2)
# Controls how the beacon behaves when it cannot reach Pulse.
mode:
  mode: registered                     # registered | standalone (default: registered)
  config_check_interval_seconds: 60    # how often to poll Pulse for config updates (default: 60)
  degraded_mode_threshold: 3           # consecutive failures before degraded mode (default: 3)
  # node_token: ""                     # token for standalone mode registration

# Optional: Payload compression (FR-4.1.5)
# Compresses heartbeat payloads above min_size_bytes.
compression:
  enabled: true                        # default: true
  level: 6                             # gzip level 1-9 (default: 6)
  min_size_bytes: 1024                 # only compress payloads larger than this (default: 1024)

# Optional: Resume / offline buffering (FR-4.1.5, FR-4.1.7)
# Buffers data to disk when Pulse is unreachable and replays it on reconnect.
resume:
  enabled: true                        # default: true
  max_cache_size_bytes: 10485760       # 10 MB cap (default: 10 MB, max 100 MB)
  cache_file_path: /var/lib/beacon/resume_cache.dat  # default path
  alert_priority_mode: true            # prioritize alert data in the cache (default: true)
  alert_reserve_percent: 30            # % of cache reserved for alerts (default: 30)

# ==================================
# Telemetry / Distributed Tracing
# ==================================
# When enabled, the Beacon wraps its outbound HTTP calls to Pulse with an
# OpenTelemetry span and injects a W3C "traceparent" header.  This enables
# end-to-end trace correlation from the Beacon probe loop through Pulse's
# API handlers.
telemetry:
  enabled: false                    # Set true to activate tracing
  service_name: beacon              # Service name in traces
  service_version: unknown          # Populated automatically in CI/CD
  otlp_endpoint: ""                 # gRPC OTLP collector, e.g. "localhost:4317"
                                    # Leave empty to export spans to stdout (dev mode)
  sampling_rate: 1.0                # 1.0 = trace all operations
