# NodePulse Beacon Configuration
# Copy this file to /etc/beacon/beacon.yaml or ./beacon.yaml

# Required: Pulse server URL (HTTP/HTTPS)
pulse_server: https://pulse.example.com

# Required: Unique node identifier (alphanumeric, hyphens, underscores)
node_id: us-east-01

# Required: Human-readable node name
node_name: "美国东部-节点01"

# Optional: Region label
region: us-east

# Optional: Custom tags
tags:
  - production
  - east-coast

# Required: API Key for JWT authentication
# Generate this on the Pulse server and associate it with your node
api_key: your-beacon-api-key-here

# Optional: Probe configurations (for Story 3.3)
# If not specified, default probes will be used
probes:
  - type: tcp_ping
    target: 8.8.8.8
    port: 80
    interval: 300      # seconds (60-300)
    count: 10          # probe attempts (1-100)
    timeout_seconds: 5 # seconds (1-30)

  - type: udp_ping
    target: 8.8.8.8
    port: 53
    interval: 300
    count: 10
    timeout_seconds: 5

# Optional: Reconnect configuration (for Story 2.6)
reconnect:
  max_retries: 10          # Maximum retry attempts (1-100)
  retry_interval: 60       # Seconds between retries (1-600)
  backoff: exponential      # Strategy: exponential, linear, constant

# Optional: Prometheus metrics configuration (for Story 3.8)
# Exposes /metrics endpoint for Prometheus scraping
metrics_enabled: true      # Enable/disable metrics server (default: true)
metrics_port: 2112         # Metrics server port (default: 2112, range: 1024-65535)
metrics_update_seconds: 10 # Metrics update interval (default: 10, range: 10-60 seconds)

# ==================================
# Telemetry / Distributed Tracing
# ==================================
# When enabled, the Beacon wraps its outbound HTTP calls to Pulse with an
# OpenTelemetry span and injects a W3C "traceparent" header.  This enables
# end-to-end trace correlation from the Beacon probe loop through Pulse's
# API handlers.
telemetry:
  enabled: false                    # Set true to activate tracing
  service_name: beacon              # Service name in traces
  service_version: unknown          # Populated automatically in CI/CD
  otlp_endpoint: ""                 # gRPC OTLP collector, e.g. "localhost:4317"
                                    # Leave empty to export spans to stdout (dev mode)
  sampling_rate: 1.0                # 1.0 = trace all operations
