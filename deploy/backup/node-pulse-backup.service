[Unit]
Description=Node-Pulse PostgreSQL daily backup
Documentation=https://github.com/whg517/node-pulse  docs/deployment-tls.md

[Service]
Type=oneshot
ExecStart=/opt/node-pulse/deploy/backup/pg-backup.sh
# Adjust User to whoever owns /var/backups/node-pulse and can run docker.
User=root
Group=root
# Optional: send failures somewhere useful
StandardOutput=journal
StandardError=journal
